<h1>Search Legislation</h1>

<div class="card">
  <%= form_tag search_path, method: :get do %>
    <div style="display: flex; gap: 0.5rem;">
      <%= text_field_tag :q, @query, placeholder: "Search across all jurisdictions...", style: "flex: 1;" %>
      <%= submit_tag "Search", class: "btn" %>
      <% if @query.present? || @jurisdiction_filter.present? || @type_filter.present? || @status_filter.present? || @year_filter.present? %>
        <%= link_to "Clear", search_path, class: "btn", style: "background: #718096;" %>
      <% end %>
    </div>
  <% end %>
</div>

<div style="display: grid; grid-template-columns: 250px 1fr; gap: 1.5rem; margin-top: 1rem;">
  <!-- Sidebar Filters -->
  <div>
    <% if @facets[:jurisdictions].any? %>
      <div class="card">
        <h3 style="margin-bottom: 0.75rem; font-size: 0.9rem;">Jurisdiction</h3>
        <% @facets[:jurisdictions].each do |jurisdiction_info, count| %>
          <% code = jurisdiction_info[:code]; name = jurisdiction_info[:name] %>
          <div style="margin-bottom: 0.25rem;">
            <% if @jurisdiction_filter == code %>
              <%= link_to search_path(q: @query, type: @type_filter, status: @status_filter, year: @year_filter), style: "text-decoration: none;" do %>
                <strong><%= name %></strong> <span class="badge badge-blue"><%= count %></span> ✕
              <% end %>
            <% else %>
              <%= link_to search_path(q: @query, jurisdiction: code, type: @type_filter, status: @status_filter, year: @year_filter), style: "text-decoration: none;" do %>
                <%= name %> <span class="badge badge-blue"><%= count %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @facets[:types].any? %>
      <div class="card">
        <h3 style="margin-bottom: 0.75rem; font-size: 0.9rem;">Type</h3>
        <% @facets[:types].each do |type, count| %>
          <div style="margin-bottom: 0.25rem;">
            <% if @type_filter == type %>
              <%= link_to search_path(q: @query, jurisdiction: @jurisdiction_filter, status: @status_filter, year: @year_filter), style: "text-decoration: none;" do %>
                <strong><%= type.humanize %></strong> <span class="badge badge-blue"><%= count %></span> ✕
              <% end %>
            <% else %>
              <%= link_to search_path(q: @query, jurisdiction: @jurisdiction_filter, type: type, status: @status_filter, year: @year_filter), style: "text-decoration: none;" do %>
                <%= type.humanize %> <span class="badge badge-blue"><%= count %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @facets[:statuses].any? %>
      <div class="card">
        <h3 style="margin-bottom: 0.75rem; font-size: 0.9rem;">Status</h3>
        <% @facets[:statuses].each do |status, count| %>
          <div style="margin-bottom: 0.25rem;">
            <% if @status_filter == status %>
              <%= link_to search_path(q: @query, jurisdiction: @jurisdiction_filter, type: @type_filter, year: @year_filter), style: "text-decoration: none;" do %>
                <strong><%= status.humanize %></strong> <span class="badge badge-green"><%= count %></span> ✕
              <% end %>
            <% else %>
              <%= link_to search_path(q: @query, jurisdiction: @jurisdiction_filter, type: @type_filter, status: status, year: @year_filter), style: "text-decoration: none;" do %>
                <%= status.humanize %> <span class="badge badge-green"><%= count %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @facets[:years].any? %>
      <div class="card">
        <h3 style="margin-bottom: 0.75rem; font-size: 0.9rem;">Year</h3>
        <% @facets[:years].each do |year, count| %>
          <div style="margin-bottom: 0.25rem;">
            <% if @year_filter == year.to_s %>
              <%= link_to search_path(q: @query, jurisdiction: @jurisdiction_filter, type: @type_filter, status: @status_filter), style: "text-decoration: none;" do %>
                <strong><%= year %></strong> <span class="badge badge-blue"><%= count %></span> ✕
              <% end %>
            <% else %>
              <%= link_to search_path(q: @query, jurisdiction: @jurisdiction_filter, type: @type_filter, status: @status_filter, year: year), style: "text-decoration: none;" do %>
                <%= year %> <span class="badge badge-blue"><%= count %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Results -->
  <div>
    <div class="card">
      <% if @query.present? || @jurisdiction_filter.present? || @type_filter.present? %>
        <h2>
          <% if @query.present? %>Results for "<%= @query %>"<% else %>All Legislation<% end %>
          (<%= @total %>)
        </h2>
      <% end %>

      <% if @results.any? %>
        <table>
          <thead>
            <tr><th>Title</th><th>Jurisdiction</th><th>Type</th><th>Year</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% @results.each do |leg| %>
              <tr>
                <td><%= link_to leg.title.truncate(80), legislation_path(leg) %></td>
                <td><%= leg.jurisdiction.code.upcase %></td>
                <td><span class="badge badge-blue"><%= leg.legislation_type %></span></td>
                <td><%= leg.year %></td>
                <td>
                  <span class="badge <%= leg.status == 'in_force' ? 'badge-green' : 'badge-red' %>">
                    <%= leg.status&.humanize %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p style="text-align: center; color: #718096; padding: 2rem;">
          <% if @query.present? %>
            No results found for "<%= @query %>". Try a different search term.
          <% else %>
            Enter a search term or browse by filters.
          <% end %>
        </p>
      <% end %>
    </div>
  </div>
</div>
