<h1><%= @legislation.title %></h1>

<div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
  <%= link_to "Export CSV", export_legislation_csv_path(@legislation), class: "btn", style: "background: #38a169; font-size: 0.8rem;" %>
  <%= link_to "Export PDF", export_legislation_pdf_path(@legislation), class: "btn", style: "background: #d69e2e; font-size: 0.8rem;" %>
</div>

<% if authenticated? %>
  <% if Current.user.watchlists.joins(:watchlist_items).where(watchlist_items: { legislation_id: @legislation.id }).exists? %>
    <%= button_to "Unwatch", unwatch_legislation_path(@legislation), method: :delete, class: "btn", style: "background: #e53e3e;" %>
  <% else %>
    <%= button_to "Watch", watch_legislation_path(@legislation), class: "btn" %>
  <% end %>
<% end %>

<div class="card">
  <h2>Metadata</h2>
  <table>
    <tr><th style="width:150px">FRBR URI</th><td><%= @legislation.frbr_uri %></td></tr>
    <tr><th>CELEX</th><td><%= @legislation.celex_number %></td></tr>
    <tr><th>ELI URI</th><td><%= @legislation.eli_uri %></td></tr>
    <tr><th>Jurisdiction</th><td><%= @legislation.jurisdiction.name %></td></tr>
    <tr><th>Type</th><td><span class="badge badge-blue"><%= @legislation.legislation_type %></span></td></tr>
    <tr><th>Year</th><td><%= @legislation.year %></td></tr>
    <tr><th>Status</th><td><span class="badge <%= @legislation.status == 'in_force' ? 'badge-green' : 'badge-red' %>"><%= @legislation.status&.humanize %></span></td></tr>
  </table>
</div>

<% if @versions.any? %>
  <div class="card">
    <h2>Versions (<%= @versions.count %>)</h2>
    <table>
      <thead>
        <tr><th>Language</th><th>Valid From</th><th>Valid To</th><th>Type</th></tr>
      </thead>
      <tbody>
        <% @versions.each do |v| %>
          <tr>
            <td><%= v.language %></td>
            <td><%= v.valid_from %></td>
            <td><%= v.valid_to || "Current" %></td>
            <td><%= v.version_type %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @document_tree.any? %>
  <div class="card">
    <h2>Document Structure</h2>
    <% @document_tree.each do |node| %>
      <%= render partial: "legislations/document_node", locals: { node: node, level: 0 } %>
    <% end %>
  </div>
<% end %>

<% if @outgoing_refs.any? || @incoming_refs.any? %>
  <div class="card">
    <h2>Cross-References</h2>

    <% if @outgoing_refs.any? %>
      <h3 style="margin-top: 1rem; font-size: 0.95rem;">This legislation references:</h3>
      <table>
        <thead><tr><th>Relationship</th><th>Legislation</th><th>Jurisdiction</th></tr></thead>
        <tbody>
          <% @outgoing_refs.each do |ref| %>
            <tr>
              <td><span class="badge badge-blue"><%= ref.reference_type %></span></td>
              <td><%= link_to ref.target_legislation.title.truncate(70), legislation_path(ref.target_legislation) %></td>
              <td><%= ref.target_legislation.jurisdiction.code.upcase %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% if @incoming_refs.any? %>
      <h3 style="margin-top: 1rem; font-size: 0.95rem;">Referenced by:</h3>
      <table>
        <thead><tr><th>Relationship</th><th>Legislation</th><th>Jurisdiction</th></tr></thead>
        <tbody>
          <% @incoming_refs.each do |ref| %>
            <tr>
              <td><span class="badge badge-yellow"><%= ref.reference_type %></span></td>
              <td><%= link_to ref.source_legislation.title.truncate(70), legislation_path(ref.source_legislation) %></td>
              <td><%= ref.source_legislation.jurisdiction.code.upcase %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>

<% if @raw_content.present? %>
  <div class="card">
    <h2>Full Text</h2>
    <div class="legislation-content">
      <%= extract_body_content(@raw_content) %>
    </div>
  </div>
<% end %>
