<div style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #333;">
  <div style="background-color: #1a365d; padding: 20px; border-radius: 8px 8px 0 0;">
    <h1 style="color: #ffffff; margin: 0; font-size: 22px;">LexAggr Watchlist Digest</h1>
  </div>

  <div style="padding: 24px; background-color: #ffffff; border: 1px solid #e2e8f0;">
    <p style="margin-top: 0;">Hello <%= @user.email_address %>,</p>

    <p style="background-color: #ebf8ff; padding: 12px 16px; border-left: 4px solid #3182ce; border-radius: 4px; margin-bottom: 24px;">
      <strong><%= @changes.length %></strong> piece<%= @changes.length == 1 ? "" : "s" %> of legislation in your watchlist
      ha<%= @changes.length == 1 ? "s" : "ve" %> been updated.
    </p>

    <% @grouped_changes.each do |jurisdiction_name, legislations| %>
      <h2 style="font-size: 16px; color: #2d3748; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; margin-top: 24px;">
        <%= jurisdiction_name %>
      </h2>

      <table style="width: 100%; border-collapse: collapse;">
        <% legislations.each do |legislation| %>
          <tr style="border-bottom: 1px solid #edf2f7;">
            <td style="padding: 12px 0;">
              <div>
                <a href="<%= legislation_url(legislation) %>" style="color: #3182ce; text-decoration: none; font-weight: 500;">
                  <%= legislation.title %>
                </a>
              </div>
              <div style="margin-top: 4px;">
                <% if legislation.legislation_type.present? %>
                  <span style="display: inline-block; background-color: #edf2f7; color: #4a5568; padding: 2px 8px; border-radius: 4px; font-size: 12px; text-transform: capitalize;">
                    <%= legislation.legislation_type.humanize %>
                  </span>
                <% end %>
                <span style="color: #a0aec0; font-size: 12px; margin-left: 8px;">
                  Updated <%= legislation.updated_at.strftime("%B %d, %Y") %>
                </span>
              </div>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>
  </div>

  <div style="padding: 16px 24px; background-color: #f7fafc; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 8px 8px; font-size: 13px; color: #718096;">
    <p style="margin: 0;">
      Update your alert preferences at
      <a href="<%= edit_alert_preferences_url %>" style="color: #3182ce;">your alert settings page</a>.
    </p>
  </div>
</div>
