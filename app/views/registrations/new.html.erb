<h1>Create Account</h1>
<div class="card" style="max-width: 400px;">
  <%= form_with model: @user, url: registration_path do |f| %>
    <% if @user.errors.any? %>
      <div style="color: #e53e3e; margin-bottom: 1rem;">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>
    <div style="margin-bottom: 1rem;">
      <%= f.label :email_address, "Email", style: "display: block; margin-bottom: 0.25rem; font-weight: 600;" %>
      <%= f.email_field :email_address, required: true, autofocus: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px;" %>
    </div>
    <div style="margin-bottom: 1rem;">
      <%= f.label :password, style: "display: block; margin-bottom: 0.25rem; font-weight: 600;" %>
      <%= f.password_field :password, required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px;" %>
    </div>
    <div style="margin-bottom: 1rem;">
      <%= f.label :password_confirmation, "Confirm Password", style: "display: block; margin-bottom: 0.25rem; font-weight: 600;" %>
      <%= f.password_field :password_confirmation, required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px;" %>
    </div>
    <%= f.submit "Create Account", class: "btn", style: "width: 100%;" %>
  <% end %>
  <p style="text-align: center; margin-top: 1rem;">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</div>
