<h1>Sign In</h1>
<div class="card" style="max-width: 400px;">
  <% if flash[:alert] %>
    <div style="color: #e53e3e; margin-bottom: 1rem;"><p><%= flash[:alert] %></p></div>
  <% end %>
  <% if flash[:notice] %>
    <div style="color: #276749; margin-bottom: 1rem;"><p><%= flash[:notice] %></p></div>
  <% end %>

  <%= form_with url: session_path do |form| %>
    <div style="margin-bottom: 1rem;">
      <%= form.label :email_address, "Email", style: "display: block; margin-bottom: 0.25rem; font-weight: 600;" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], style: "width: 100%; padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px;" %>
    </div>
    <div style="margin-bottom: 1rem;">
      <%= form.label :password, style: "display: block; margin-bottom: 0.25rem; font-weight: 600;" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, style: "width: 100%; padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px;" %>
    </div>
    <%= form.submit "Sign In", class: "btn", style: "width: 100%;" %>
  <% end %>

  <p style="text-align: center; margin-top: 1rem;"><%= link_to "Forgot password?", new_password_path %></p>
  <p style="text-align: center; margin-top: 0.5rem;">Don't have an account? <%= link_to "Create Account", registration_path %></p>
</div>
